{
	"name": "get_issue",
	"request": {
		"op": "get_issue",
		"repo": "SEA",
		"number": 7,
		"method": "POST",
		"path": "/graphql",
		"body": {
			"query": "query CompassIssueGet($filter: IssueFilter!) {\n  issues(filter: $filter, first: 1) {\n    nodes { ...CompassIssueFields }\n  }\n}\nfragment CompassIssueFields on Issue {\n  number\n  title\n  description\n  url\n  state { name type }\n  labels { nodes { name } }\n  creator { displayName }\n  updatedAt\n}",
			"variables": {
				"filter": {
					"team": { "key": { "eq": "SEA" } },
					"number": { "eq": 7 }
				}
			}
		}
	},
	"response": {
		"status": 200,
		"body": {
			"data": {
				"issues": {
					"nodes": [
						{
							"number": 7,
							"title": "a bug",
							"description": "raw <!--owner--> body",
							"url": "https://linear.app/x/issue/RIG-7",
							"state": { "name": "Todo", "type": "unstarted" },
							"labels": { "nodes": [] },
							"creator": null,
							"updatedAt": "2026-08-01T12:30:00Z"
						}
					]
				}
			}
		},
		"want": {
			"Number": 7,
			"Title": "a bug",
			"Body": "raw <!--owner--> body",
			"State": "open",
			"URL": "https://linear.app/x/issue/RIG-7",
