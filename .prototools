# Language/runtime toolchains, pinned per the proto/devenv split
# (docs/architecture/build-and-ci.md): proto owns these; devenv
# (devenv.nix) provides proto itself plus every other (non-language) tool.
#
# moon is pinned here (the 2.x line) rather than from nixpkgs, which lags on
# the 1.x line. Rust's version is owned by rust-toolchain.toml — proto reads
# it from there — so it is not duplicated here.
bun = "1.3.13"
node = "22.23.1"
moon = "2.3.4"
