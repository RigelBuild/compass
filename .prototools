# Language/runtime toolchains, pinned per the proto/devenv split: proto owns
# these; devenv (devenv.nix) provides proto itself + every other tool.
#
# moon is pinned HERE rather than taken from nixpkgs (which lags on the
# 1.x line) so it tracks the 2.x series.
bun = "1.3.13"
node = "24.18.0"
moon = "2.4.2"
# Go is the backend language. proto owns the toolchain pin like the others; the
# dev shell installs it via `proto install` (enterShell). Floor policy: the `go`
# directive in go/go.mod tracks this pin minus at most one minor, so an upstream
# security patch never blocks on a mod edit.
go = "1.26.6"
