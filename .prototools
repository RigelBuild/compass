# Runtime toolchains (bun/node/moon), pinned per the proto/devenv split
# (docs/architecture/build-and-ci.md): proto owns these; devenv (devenv.nix)
# provides proto itself plus every other tool.
#
# moon is pinned here (the 2.x line) rather than from nixpkgs, which lags on
# the 1.x line. Rust is not listed here: rust-toolchain.toml owns the Rust
# version, built via fenix in the dev shell + CI image (or rustup, no-nix).
bun = "1.3.13"
node = "22.23.1"
moon = "2.3.4"
