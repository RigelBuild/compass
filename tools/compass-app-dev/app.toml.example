# Compass native-app config. The app writes app.toml once, after first-run setup
# succeeds. It never rewrites an existing file. Copy this template only when
# you want to configure client mode by hand. Unknown keys are rejected.

# For client mode, set the server connection below. The first-run chooser can
# also collect these settings in the app.
mode = "client"

# Required for a hand-written client config. Use an absolute https origin:
# scheme, host, and optional port. A root trailing slash is accepted and
# removed; non-root paths, queries, and fragments are rejected.
server_url = "https://your-server.example.ts.net:50061"

# Optional PEM trust anchor for a server whose cert chains to a private CA
# (a compass-server dev/dogfood env mints its own). Omit (or leave "") to trust
# the system roots only. Absolute path.
# ca_cert = "/Users/you/.config/compass/server-ca.crt"

# The bearer token is NOT configured here: tokenstore keeps it in the OS keychain
# or a 0600 fallback file — never in this file, argv, or env.
