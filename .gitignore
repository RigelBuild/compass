# moon (task cache + generated docker contexts)
.moon/cache
.moon/docker

# Rust
/target
**/target

# Node / bun
node_modules
dist
*.tsbuildinfo

# devenv / direnv
.devenv*
.direnv
devenv.local.nix

# direnv local overrides (e.g. a secondary jj workspace's GIT_DIR)
.envrc.local

# nix build outputs
result
result-*

# misc
*.log
.DS_Store

# NOTE: generated clients (go/gen, packages/compass-client/src/gen)
# are intentionally committed and drift-gated — do not ignore them.

# Vendored fork subtrees (forks/<name>/) are upstream code, vendored into this
# repo per SEA-1512. Of the unanchored patterns above, the only one that
# actually catches tracked upstream files in these trees is `.DS_Store` (two of
# them, under forks/devenv/logos/), so that is all the negation re-includes.
# Keeping it anchored to the file pattern — rather than a `!forks/**` blanket —
# means real build detritus inside a fork (dist/, *.log, node_modules/, result)
# stays ignored; forks/nix2container carries no .gitignore of its own, and
# forks/devenv's covers result/target/node_modules but not dist or *.log.
# Unrelated: proptest-regressions/, poetry.lock, devenv.local.*, and uv.lock are
# hidden by the forks' OWN nested .gitignore files, which no root negation
# overrides — they predate the ignore rules in the index and stay tracked
# regardless.
#
# IMPORTING A NEW FORK: this anchor only rescues .DS_Store, so an upstream tree
# that legitimately tracks an ignored-pattern path loses those files SILENTLY —
# a bulk `git add -A` skips them with no warning and no error (git only warns on
# an explicit `git add <ignored-path>`), and nothing in CI checks file counts.
# This is real, not hypothetical: hermes-agent tracks checked-in plugin build
# output at plugins/*/dashboard/dist/*. So before committing an import, compare
# `git ls-files forks/<name> | wc -l` against the source tree's count. If they
# differ, find the cause with
# `git ls-files --others --ignored --exclude-standard forks/<name>` and add a
# matching anchored negation below, e.g. `!forks/<name>/**/dist/**`.
!forks/**/.DS_Store
