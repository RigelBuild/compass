# moon (task cache + generated docker contexts)
.moon/cache
.moon/docker

# golangci-lint per-workspace caches (compass-go:lint sets GOLANGCI_LINT_CACHE
# to $projectRoot/.golangci-cache; the review lane uses a -review suffix). Both
# avoid shared-cache contention and must never be committed.
/go/.golangci-cache/
/go/.golangci-cache-review/

# Rust
/target
**/target

# Node / bun
node_modules
dist
*.tsbuildinfo
# transient tsc declaration emit for the transport export-surface containment
# test (packages/compass-agent/src/transport/export-surface.test.ts); always
# cleaned in a finally, ignored so a hard crash never leaves a tracked artifact.
.dts-surface-*

# devenv / direnv
.devenv*
.direnv
devenv.local.nix

# direnv local overrides (e.g. a secondary jj workspace's GIT_DIR)
.envrc.local

# nix build outputs
result
result-*

# misc
*.log
.DS_Store

# Go build artifacts: `go build ./cmd/compass` emits the binary into go/.
# The binary is built by moon/CI into the task cache, never committed.
/go/compass

# NOTE: generated clients (go/gen, packages/compass-client/src/gen)
# are intentionally committed and CI drift-gated — do not ignore them.

# Vendored fork subtrees (forks/<name>/) are upstream code vendored into this
# repo. None of the unanchored patterns above currently catches a tracked file
# in the remaining fork tree (forks/oh-my-pi/), so no re-including negation is
# needed. Real build detritus inside a fork (dist/, *.log, node_modules/,
# result) stays ignored.
# Unrelated: proptest-regressions/, poetry.lock, devenv.local.*, and uv.lock are
# hidden by the forks' OWN nested .gitignore files, which no root negation
# overrides — they predate the ignore rules in the index and stay tracked
# regardless.
#
# IMPORTING A NEW FORK: an unanchored ignore pattern here silently drops any
# upstream tree file matching it — a bulk `git add -A` skips it with no warning
# and no error (git only warns on an explicit `git add <ignored-path>`), and
# nothing in CI checks file counts. This is real, not hypothetical: hermes-agent
# tracks checked-in plugin build output at plugins/*/dashboard/dist/*. So before
# committing an import, compare `git ls-files forks/<name> | wc -l` against the
# source tree's count. If they differ, find the cause with
# `git ls-files --others --ignored --exclude-standard forks/<name>` and add a
# matching anchored negation here, e.g. `!forks/<name>/**/dist/**`.
