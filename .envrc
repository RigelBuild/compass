# Auto-loads the devenv shell (devenv.nix) on cd into the repo — the full
# dev + CI toolchain. Run `direnv allow` once.
#
# The source_url line pulls devenv's direnv integration (`use devenv`) at a
# pinned rev, so this works without a globally-installed devenv direnvrc.
source_url "https://raw.githubusercontent.com/cachix/devenv/82c0147677e510b247d8b9165c54f73d32dfd899/direnvrc" "sha256-7u4iDd1nZpxL4tCzmPG0dQgC5V+/44Ba+tHkPob1v2k="

# direnv re-runs the shell only when a watched file changes; the per-language
# pin files under tools/toolchain/versions/ hold the toolchain versions, so
# watch them to pick up bun/node/moon/go bumps.
watch_file tools/toolchain/versions/bun.nix
watch_file tools/toolchain/versions/node.nix
watch_file tools/toolchain/versions/moon.nix
watch_file tools/toolchain/versions/go.nix

use devenv

# Local, gitignored overrides. Loaded after devenv so it can override the env.
source_env_if_exists .envrc.local
